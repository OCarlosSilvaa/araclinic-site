  /* ---------- Fontes (self-hosted, sem dependência externa) ---------- */
  @font-face{
    font-family:'Cormorant Garamond';
    font-style:normal;
    font-weight:300;
    font-display:swap;
    src:url('../fonts/cormorant-garamond-latin-300-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Cormorant Garamond';
    font-style:normal;
    font-weight:400;
    font-display:swap;
    src:url('../fonts/cormorant-garamond-latin-400-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Cormorant Garamond';
    font-style:normal;
    font-weight:500;
    font-display:swap;
    src:url('../fonts/cormorant-garamond-latin-500-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Cormorant Garamond';
    font-style:normal;
    font-weight:600;
    font-display:swap;
    src:url('../fonts/cormorant-garamond-latin-600-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Cormorant Garamond';
    font-style:italic;
    font-weight:400;
    font-display:swap;
    src:url('../fonts/cormorant-garamond-latin-400-italic.woff2') format('woff2');
  }
  @font-face{
    font-family:'Jost';
    font-style:normal;
    font-weight:200;
    font-display:swap;
    src:url('../fonts/jost-latin-200-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Jost';
    font-style:normal;
    font-weight:300;
    font-display:swap;
    src:url('../fonts/jost-latin-300-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Jost';
    font-style:normal;
    font-weight:400;
    font-display:swap;
    src:url('../fonts/jost-latin-400-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Jost';
    font-style:normal;
    font-weight:500;
    font-display:swap;
    src:url('../fonts/jost-latin-500-normal.woff2') format('woff2');
  }
  @font-face{
    font-family:'Jost';
    font-style:normal;
    font-weight:600;
    font-display:swap;
    src:url('../fonts/jost-latin-600-normal.woff2') format('woff2');
  }

  :root{
    --cream:#F8F6F1;
    --white:#FFFFFF;
    --beige:#E8E0D2;
    --gold:#C6A15B;
    --gold-dark:#A8843E;
    --brown:#332B22;
    --brown-soft:#716757;
    --serif:'Cormorant Garamond', serif;
    --sans:'Jost', sans-serif;
    color-scheme: light;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--brown);
    font-family:var(--sans);
    font-weight:300;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  ::selection{background:var(--gold); color:var(--white);}

  .container{
    width:100%;
    max-width:1360px;
    margin:0 auto;
    padding:0 40px;
  }

  h1,h2,h3,h4{
    font-family:var(--serif);
    font-weight:500;
    color:var(--brown);
    line-height:1.15;
  }

  .eyebrow-label{
    font-family:var(--sans);
    font-size:12px;
    letter-spacing:0.28em;
    color:var(--gold-dark);
    font-weight:500;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:16px 34px;
    font-family:var(--sans);
    font-size:12.5px;
    letter-spacing:0.16em;
    font-weight:500;
    border-radius:2px;
    transition:all .5s cubic-bezier(.22,1,.36,1);
    cursor:pointer;
    border:1px solid transparent;
    white-space:nowrap;
  }
  .btn-gold{
    background:linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
    color:var(--white);
    box-shadow:0 8px 24px -8px rgba(166,131,60,.55);
  }
  .btn-gold:hover{ transform:translateY(-2px); box-shadow:0 14px 32px -10px rgba(166,131,60,.65); }
  .btn-outline{
    background:transparent;
    border:1px solid rgba(51,43,34,.28);
    color:var(--brown);
  }
  .btn-outline:hover{ border-color:var(--gold); color:var(--gold-dark); }
  .btn-outline-light{
    background:transparent;
    border:1px solid rgba(255,255,255,.5);
    color:var(--white);
  }
  .btn-outline-light:hover{ border-color:var(--gold); background:rgba(255,255,255,.08); }

  .btn-instagram{
    background:transparent;
    border:1px solid var(--gold);
    color:var(--gold-dark);
  }
  .btn-instagram svg{ width:16px; height:16px; transition:transform .45s cubic-bezier(.22,1,.36,1); }
  .btn-instagram:hover{ background:var(--gold); color:var(--white); }
  .btn-instagram:hover svg{ transform:scale(1.1) rotate(-6deg); }

  .cta-buttons{
    display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:16px;
    margin-top:8px;
  }

  /* ---------- Reveal animation ---------- */
  [data-reveal]{
    opacity:0;
    transform:translateY(36px);
    transition:opacity 1s cubic-bezier(.22,1,.36,1), transform 1.1s cubic-bezier(.22,1,.36,1);
  }
  [data-reveal].in-view{ opacity:1; transform:translateY(0); }
  [data-reveal="fade"]{ transform:none; }
  [data-reveal="fade"].in-view{ transform:none; }
  [data-reveal="scale"]{ transform:scale(1.06); }
  [data-reveal="scale"].in-view{ transform:scale(1); }
  [data-reveal="left"]{ transform:translateX(-40px); }
  [data-reveal="left"].in-view{ transform:translateX(0); }
  [data-reveal="right"]{ transform:translateX(40px); }
  [data-reveal="right"].in-view{ transform:translateX(0); }

  @media(prefers-reduced-motion: reduce){
    [data-reveal]{ opacity:1 !important; transform:none !important; transition:none !important; }
    *{ animation-duration:.001s !important; }
  }

  /* ---------- Header ---------- */
  header{
    position:fixed; top:0; left:0; width:100%; z-index:200;
    padding:26px 0;
    transition:padding .5s cubic-bezier(.22,1,.36,1), background .5s ease, box-shadow .5s ease, backdrop-filter .5s ease;
  }
  header.scrolled{
    padding:14px 0;
    background:rgba(248,246,241,.86);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    box-shadow:0 8px 30px -18px rgba(51,43,34,.25);
  }
  .header-inner{
    display:flex; align-items:center; justify-content:space-between;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand img{ height:46px; width:auto; transition:height .5s ease; filter:drop-shadow(0 2px 6px rgba(0,0,0,.15)); }
  header.scrolled .brand img{ height:38px; }

  nav.main-nav{ display:flex; align-items:center; gap:44px; }
  nav.main-nav a{
    font-size:12.5px; letter-spacing:.14em; font-weight:400; color:var(--brown);
    position:relative; padding-bottom:4px;
  }
  body.dark-header nav.main-nav a{ color:var(--white); }
  header.scrolled nav.main-nav a{ color:var(--brown); }
  nav.main-nav a::after{
    content:''; position:absolute; left:0; bottom:0; width:0; height:1px; background:var(--gold);
    transition:width .4s cubic-bezier(.22,1,.36,1);
  }
  nav.main-nav a:hover::after{ width:100%; }

  .header-right{ display:flex; align-items:center; gap:28px; }
  .hamburger{ display:none; flex-direction:column; gap:5px; cursor:pointer; background:none; border:none; padding:8px; z-index:210; }
  .hamburger span{ width:24px; height:1px; background:var(--brown); transition:all .4s ease; }
  body.dark-header .hamburger span{ background:var(--white); }
  header.scrolled .hamburger span{ background:var(--brown); }
  .hamburger.active span{ background:var(--brown) !important; }
  .hamburger.active span:nth-child(1){ transform:translateY(6px) rotate(45deg); }
  .hamburger.active span:nth-child(2){ opacity:0; }
  .hamburger.active span:nth-child(3){ transform:translateY(-6px) rotate(-45deg); }

  .mobile-menu{
    position:fixed; inset:0; background:var(--cream); z-index:190;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:34px;
    opacity:0; visibility:hidden; transform:translateY(-16px);
    transition:opacity .55s cubic-bezier(.22,1,.36,1), transform .55s cubic-bezier(.22,1,.36,1), visibility 0s linear .55s;
  }
  .mobile-menu.active{ opacity:1; visibility:visible; transform:translateY(0); transition:opacity .55s cubic-bezier(.22,1,.36,1), transform .55s cubic-bezier(.22,1,.36,1); }
  .mobile-menu a{ font-family:var(--serif); font-size:30px; color:var(--brown); }
  .mobile-menu .btn{ margin-top:14px; }

  /* ---------- Hero ---------- */
  .hero{
    position:relative; min-height:100vh; display:flex; align-items:flex-end;
    overflow:hidden;
  }
  .hero-bg{
    position:absolute; inset:0; overflow:hidden;
  }
  .hero-bg img{
    width:100%; height:100%; object-fit:cover; object-position:60% 30%;
    transform:scale(1.14);
    animation:heroZoom 1.8s cubic-bezier(.22,1,.36,1) forwards;
  }
  @keyframes heroZoom{ to{ transform:scale(1.0); } }
  .hero-bg::after{
    content:'';
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(30,24,16,.32) 0%, rgba(24,19,13,.28) 45%, rgba(15,12,8,.78) 100%);
  }
  .hero-content{
    position:relative; z-index:2; width:100%;
    padding:0 0 110px;
  }
  .hero-inner{ max-width:820px; }
  .hero-eyebrow{
    color:var(--gold); font-size:12.5px; letter-spacing:.3em; font-weight:500; margin-bottom:22px;
    opacity:0; animation:fadeUp .9s cubic-bezier(.22,1,.36,1) .5s forwards;
  }
  .hero h1{
    color:var(--white); font-size:clamp(40px, 6.4vw, 84px); font-weight:400; letter-spacing:-.01em;
  }
  .hero h1 .line{
    display:block; overflow:hidden;
  }
  .hero h1 .line span{
    display:inline-block; opacity:0; transform:translateY(100%);
    animation:lineUp 1.1s cubic-bezier(.22,1,.36,1) forwards;
  }
  .hero h1 .line:nth-child(1) span{ animation-delay:.65s; }
  .hero h1 .line:nth-child(2) span{ animation-delay:.85s; }
  @keyframes lineUp{ to{ opacity:1; transform:translateY(0); } }

  .hero p.sub{
    color:rgba(255,255,255,.86); font-size:clamp(16px,1.6vw,19px); font-weight:300; max-width:480px;
    margin:28px 0 42px; line-height:1.6;
    opacity:0; animation:fadeUp .9s cubic-bezier(.22,1,.36,1) 1.25s forwards;
  }
  .hero-ctas{
    display:flex; gap:18px; flex-wrap:wrap;
    opacity:0; animation:fadeUp .9s cubic-bezier(.22,1,.36,1) 1.5s forwards;
  }
  @keyframes fadeUp{ from{opacity:0; transform:translateY(22px);} to{opacity:1; transform:translateY(0);} }

  .scroll-indicator{
    position:absolute; right:44px; bottom:38px; z-index:2;
    display:flex; flex-direction:column; align-items:center; gap:12px;
    color:rgba(255,255,255,.75); font-size:10.5px; letter-spacing:.32em;
    opacity:0; animation:fadeUp .9s ease 1.9s forwards;
  }
  .scroll-line{ width:1px; height:46px; background:rgba(255,255,255,.4); position:relative; overflow:hidden; }
  .scroll-line::after{
    content:''; position:absolute; top:-40%; left:0; width:100%; height:40%; background:var(--gold);
    animation:scrollMove 1.8s ease-in-out infinite;
  }
  @keyframes scrollMove{ 0%{top:-40%;} 60%{top:100%;} 100%{top:100%;} }

  .gold-dot{
    position:absolute; width:6px; height:6px; border-radius:50%; background:var(--gold);
    opacity:0; animation:dotFloat 1s ease 2.1s forwards, floaty 5s ease-in-out infinite 3s;
  }
  @keyframes dotFloat{ to{opacity:.85;} }
  @keyframes floaty{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-14px);} }

  /* ---------- Section basics ---------- */
  section{ position:relative; }
  .section-pad{ padding:110px 0; }
  @media(max-width:768px){ .section-pad{ padding:72px 0; } }

  .section-head{ max-width:640px; margin-bottom:48px; }
  .section-head .eyebrow-label{ display:block; margin-bottom:18px; }
  .section-head h2{ font-size:clamp(32px, 4vw, 50px); }

  .divider-gold{ width:64px; height:1px; background:var(--gold); }

  /* ---------- A Clinica ---------- */
  .clinic-grid{
    display:grid; grid-template-columns:1.05fr .95fr; gap:0 60px; align-items:center;
  }
  .clinic-visual{ position:relative; }
  .clinic-visual .img-main{
    width:88%; border-radius:2px; overflow:hidden; box-shadow:0 40px 80px -40px rgba(51,43,34,.45);
  }
  .clinic-visual .img-main img{ aspect-ratio:4/5; object-fit:cover; }
  .clinic-visual .img-small{
    position:absolute; right:0; bottom:-56px; width:46%; border-radius:2px; overflow:hidden;
    border:8px solid var(--cream); box-shadow:0 30px 60px -30px rgba(51,43,34,.5);
  }
  .clinic-visual .img-small img{ aspect-ratio:1/1; object-fit:cover; }
  .clinic-visual .frame-line{
    position:absolute; top:-30px; left:-30px; width:120px; height:120px;
    border-top:1px solid var(--gold); border-left:1px solid var(--gold);
  }

  .clinic-text p.lede{ font-size:20px; line-height:1.7; color:var(--brown-soft); font-weight:300; margin:26px 0 0; }

  /* ---------- Profissional ---------- */
  .prof-section{ padding-top:0; }
  .prof-grid{
    display:grid; grid-template-columns:.85fr 1.15fr; gap:60px; align-items:center;
  }
  .prof-visual{
    position:relative; display:grid;
    grid-template-columns:1.35fr 1fr; grid-template-rows:1fr 1fr;
    gap:16px; aspect-ratio:4/3.1;
  }
  .prof-visual .prof-img{ border-radius:2px; overflow:hidden; box-shadow:0 34px 70px -36px rgba(51,43,34,.45); }
  .prof-img-1{ grid-column:1; grid-row:1 / 3; }
  .prof-img-2{ grid-column:2; grid-row:1; }
  .prof-img-3{ grid-column:2; grid-row:2; }
  .prof-visual .prof-img img{ width:100%; height:100%; object-fit:cover; display:block; }
  @media(max-width:640px){
    .prof-visual{ grid-template-columns:1fr 1fr; grid-template-rows:auto auto; aspect-ratio:auto; gap:12px; }
    .prof-img-1{ grid-column:1 / 3; grid-row:1; aspect-ratio:16/10; }
    .prof-img-1 img{ object-position:center 12%; }
    .prof-img-2{ grid-column:1; grid-row:2; aspect-ratio:1/1; }
    .prof-img-3{ grid-column:2; grid-row:2; aspect-ratio:1/1; }
  }
  .prof-text p.lede{ font-size:19px; line-height:1.7; color:var(--brown-soft); font-weight:300; margin-top:22px; }

  /* ---------- Tratamentos ---------- */
  .treat-grid{
    display:flex; flex-wrap:wrap; gap:2px; background:rgba(51,43,34,.08);
  }
  .treat-card{
    flex:1 1 260px;
    background:var(--cream); padding:46px 34px; position:relative; overflow:hidden;
    transition:background .5s ease, transform .5s cubic-bezier(.22,1,.36,1);
    min-height:260px; display:flex; flex-direction:column; justify-content:space-between;
  }
  .treat-card::before{
    content:''; position:absolute; inset:0; border:1px solid transparent; transition:border-color .5s ease; pointer-events:none;
  }
  .treat-card:hover{ background:var(--white); transform:translateY(-6px); z-index:2; box-shadow:0 30px 60px -30px rgba(51,43,34,.25); }
  .treat-card:hover::before{ border-color:var(--gold); }
  .treat-icon{ width:38px; height:38px; color:var(--gold-dark); margin-bottom:26px; }
  .treat-card h3{ font-size:22px; font-weight:500; margin-bottom:10px; }
  .treat-card p{ font-size:13.5px; color:var(--brown-soft); line-height:1.55; font-weight:300; }
  .treat-arrow{ margin-top:26px; display:flex; align-items:center; gap:8px; font-size:11px; letter-spacing:.14em; color:var(--gold-dark); font-weight:500; }
  .treat-arrow svg{ width:14px; height:14px; transition:transform .45s cubic-bezier(.22,1,.36,1); }
  .treat-card:hover .treat-arrow svg{ transform:translateX(6px); }

  /* ---------- Resultados ---------- */
  .masonry{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;
  }
  .m-item{ position:relative; overflow:hidden; border-radius:2px; cursor:pointer; aspect-ratio:1/1; }
  .m-item img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform 1s cubic-bezier(.22,1,.36,1); }
  .m-item:hover img{ transform:scale(1.06); }
  .m-item .m-overlay{
    position:absolute; inset:0; background:linear-gradient(180deg, transparent 62%, rgba(20,16,11,.66) 100%);
    opacity:0; transition:opacity .5s ease;
  }
  .m-item:hover .m-overlay{ opacity:1; }
  .m-tag{
    position:absolute; left:18px; bottom:16px; color:var(--white); font-size:11px; letter-spacing:.2em; font-weight:500;
    opacity:0; transform:translateY(10px); transition:all .5s cubic-bezier(.22,1,.36,1);
  }
  .m-item:hover .m-tag{ opacity:1; transform:translateY(0); }

  /* ---------- Lightbox ---------- */
  .lightbox{
    position:fixed; inset:0; z-index:500; background:rgba(20,16,11,.94);
    display:flex; align-items:center; justify-content:center; padding:60px;
    opacity:0; visibility:hidden; transition:opacity .4s ease, visibility 0s linear .4s;
  }
  .lightbox.active{ opacity:1; visibility:visible; transition:opacity .4s ease; }
  .lightbox-img-wrap{ position:relative; max-width:100%; max-height:100%; display:flex; align-items:center; justify-content:center; }
  .lightbox img{
    max-width:100%; max-height:82vh; width:auto; height:auto; object-fit:contain;
    box-shadow:0 50px 110px -20px rgba(0,0,0,.65); border-radius:2px;
    opacity:0; transform:scale(.96); transition:opacity .4s ease .05s, transform .4s cubic-bezier(.22,1,.36,1) .05s;
  }
  .lightbox.active img{ opacity:1; transform:scale(1); }
  .lightbox-close{
    position:absolute; top:28px; right:32px; width:46px; height:46px; border-radius:50%;
    background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.35); color:var(--white);
    font-size:24px; line-height:1; display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:all .35s ease; z-index:2;
  }
  .lightbox-close:hover{ background:rgba(255,255,255,.18); border-color:var(--gold); }
  .lightbox-cap{
    position:absolute; bottom:24px; left:0; right:0; text-align:center;
    color:rgba(255,255,255,.78); font-size:11px; letter-spacing:.24em; font-weight:500;
  }
  @media(max-width:640px){
    .lightbox{ padding:20px; }
    .lightbox-close{ top:16px; right:16px; width:40px; height:40px; font-size:20px; }
    .lightbox img{ max-height:76vh; }
  }

  /* ---------- Experiencia (parallax) ---------- */
  .experience{ height:78vh; min-height:520px; position:relative; overflow:hidden; }
  .experience .px-img{ position:absolute; inset:-10% 0; width:100%; height:120%; object-fit:cover; will-change:transform; }
  .experience::after{ content:''; position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,16,11,.28), rgba(20,16,11,.5)); }
  .experience-text{
    position:relative; z-index:2; height:100%; display:flex; align-items:center; justify-content:center; text-align:center;
  }
  .experience-text h2{ color:var(--white); font-size:clamp(30px, 4.6vw, 56px); font-weight:400; max-width:720px; padding:0 24px; }

  /* ---------- Instagram ---------- */
  .insta-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:56px; }
  .insta-item{ aspect-ratio:1/1; overflow:hidden; border-radius:2px; position:relative; }
  .insta-item img{ width:100%; height:100%; object-fit:cover; transition:transform .8s cubic-bezier(.22,1,.36,1); filter:saturate(.92); }
  .insta-item:hover img{ transform:scale(1.08); }

  /* ---------- CTA final ---------- */
  .cta-final{ text-align:center; padding:130px 0; }
  .cta-final h2{ font-size:clamp(34px,5vw,60px); margin-bottom:22px; }
  .cta-final p{ color:var(--brown-soft); font-size:18px; max-width:460px; margin:0 auto 44px; font-weight:300; }
  .cta-final .loc{ margin-top:30px; font-size:12px; letter-spacing:.18em; color:var(--brown-soft); }

  /* ---------- Footer ---------- */
  footer{ background:var(--brown); color:rgba(248,246,241,.72); padding:64px 0 34px; }
  .footer-grid{ display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:40px; padding-bottom:48px; border-bottom:1px solid rgba(248,246,241,.12); }
  footer .brand img{ height:44px; filter:brightness(0) invert(1) drop-shadow(0 0 0 transparent); opacity:.92; }
  footer h4{ color:var(--cream); font-size:12px; letter-spacing:.14em; font-weight:500; margin-bottom:22px; font-family:var(--sans); }
  footer .foot-links a{ display:block; font-size:14px; margin-bottom:12px; color:rgba(248,246,241,.68); transition:color .35s ease; }
  footer .foot-links a:hover{ color:var(--gold); }
  footer .foot-desc{ font-size:14px; line-height:1.7; max-width:280px; margin-top:20px; font-weight:300; }
  .foot-bottom{ padding-top:30px; display:flex; justify-content:space-between; font-size:12px; color:rgba(248,246,241,.45); flex-wrap:wrap; gap:12px; }

  /* ---------- WhatsApp float ---------- */
  .wa-float{
    position:fixed; right:26px; bottom:26px; z-index:150;
    display:flex; align-items:center; gap:12px;
  }
  .wa-label{
    background:var(--brown); color:var(--cream); font-size:12.5px; padding:11px 18px; border-radius:2px;
    white-space:nowrap; opacity:0; transform:translateX(10px); transition:all .4s cubic-bezier(.22,1,.36,1); pointer-events:none;
    box-shadow:0 10px 30px -10px rgba(0,0,0,.4);
  }
  .wa-float:hover .wa-label{ opacity:1; transform:translateX(0); }
  .wa-btn{
    width:58px; height:58px; border-radius:50%; background:linear-gradient(135deg, var(--gold), var(--gold-dark));
    display:flex; align-items:center; justify-content:center; box-shadow:0 14px 34px -10px rgba(166,131,60,.6);
    position:relative; flex-shrink:0;
  }
  .wa-btn::before{
    content:''; position:absolute; inset:-6px; border-radius:50%; border:1px solid var(--gold);
    opacity:.55; animation:pulseRing 2.6s ease-out infinite;
  }
  @keyframes pulseRing{ 0%{ transform:scale(.9); opacity:.55; } 100%{ transform:scale(1.5); opacity:0; } }
  .wa-btn svg{ width:27px; height:27px; fill:var(--white); position:relative; z-index:1; }

  /* ---------- Focus states ---------- */
  a:focus-visible, button:focus-visible{ outline:2px solid var(--gold-dark); outline-offset:3px; }

  /* ---------- Responsive ---------- */
  @media(max-width:1024px){
    .container{ padding:0 28px; }
    nav.main-nav{ display:none; }
    .hamburger{ display:flex; }
    .clinic-grid{ grid-template-columns:1fr; gap:90px 0; }
    .clinic-visual{ order:1; }
    .clinic-text{ order:2; }
    .clinic-visual .img-main{ width:100%; }
    .clinic-visual .img-small{ width:52%; right:-4%; bottom:-40px; }
    .prof-grid{ grid-template-columns:1fr; gap:70px; }
    .prof-visual{ order:1; }
    .prof-text{ order:2; }
    .treat-card{ flex:1 1 45%; }
    .masonry{ grid-template-columns:repeat(2,1fr); }
    .insta-grid{ grid-template-columns:repeat(2,1fr); }
    .footer-grid{ grid-template-columns:1fr 1fr; row-gap:40px; }
    .footer-grid > div:first-child{ grid-column:1 / -1; }
  }
  @media(max-width:640px){
    .container{ padding:0 22px; }
    .hero{ align-items:flex-end; }
    .hero-content{ padding-bottom:86px; }
    .hero-ctas{ flex-direction:column; align-items:flex-start; }
    .btn{ width:100%; justify-content:center; }
    .hero-ctas .btn{ width:auto; padding:15px 28px; }
    .scroll-indicator{ display:none; }
    .treat-card{ flex:1 1 100%; }
    .masonry{ grid-template-columns:1fr; }
    .insta-grid{ grid-template-columns:repeat(2,1fr); }
    .footer-grid{ grid-template-columns:1fr; }
    .section-head{ margin-bottom:44px; }
  }
