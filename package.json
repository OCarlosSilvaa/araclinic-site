  </a>
</div>

<!-- ===== LIGHTBOX ===== -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Imagem ampliada">
  <button class="lightbox-close" id="lightboxClose" aria-label="Fechar imagem ampliada">&times;</button>
  <div class="lightbox-img-wrap">
    <img id="lightboxImg" src="" alt="">
  </div>
  <span class="lightbox-cap" id="lightboxCap"></span>
</div>


<script src="js/main.js"></script>
</body>
</html>
